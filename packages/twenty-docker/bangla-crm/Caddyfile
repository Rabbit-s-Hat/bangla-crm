{
	email {$ACME_EMAIL}
}

# Setup gate: right after a cloud install only the owner's IP address may open the site, so nobody
# else can sign up first and become administrator. `sudo bash bangla-crm.sh finish-setup` turns it off.
(gate-on) {
	@not_owner not remote_ip {$SETUP_ALLOW_IP:127.0.0.1}
	respond @not_owner "Bangla CRM is being set up. Please try again later." 403
}
(gate-off) {
	header -Server
}

{$DOMAIN} {
	encode zstd gzip
	import gate-{$SETUP_GATE:off}
	reverse_proxy server:3000
}
