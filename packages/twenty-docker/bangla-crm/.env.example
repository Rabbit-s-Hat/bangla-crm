# Bangla CRM settings. The installer creates `.env` from this template and fills in the secrets.
# KEEP `.env` SAFE AND BACKED UP: without ENCRYPTION_KEY, stored passwords and tokens cannot be
# decrypted, and without PG_DATABASE_PASSWORD the database cannot be opened.

# Image version (a release number such as 0.1.0). The Update command changes it for you.
TAG=latest

# The address people type in the browser. Must match HTTP_PORT (local) or your domain (cloud).
SERVER_URL=http://localhost:3000

# Port on this computer. Change SERVER_URL too if you change it (or re-run the installer with --port / -Port).
HTTP_PORT=3000

# 127.0.0.1 = only this computer can open Bangla CRM.
# 0.0.0.0   = other computers on your network can open it at http://<this-computer's-IP>:HTTP_PORT
#             (re-run the installer with --lan / -Lan instead of editing this by hand).
BIND_ADDRESS=127.0.0.1

# Sender name of system emails (password reset, verification).
EMAIL_FROM_NAME=Bangla CRM

# ---------------------------------------------------------------------------------------------
# SET ONCE BY THE INSTALLER - NEVER CHANGE THESE AFTER THE FIRST START.
# The database keeps its original login, and a different ENCRYPTION_KEY makes saved passwords,
# connected email accounts and sign-in tokens unusable. (Key rotation: see the Twenty docs.)
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=
PG_DATABASE_NAME=default
ENCRYPTION_KEY=
FALLBACK_ENCRYPTION_KEY=

# Cloud servers only (written by deploy-cloud.sh / install.sh --domain):
# COMPOSE_FILE=docker-compose.yml:docker-compose.cloud.yml
# DOMAIN=crm.example.com
# ACME_EMAIL=you@example.com
# SETUP_GATE=on            (only SETUP_ALLOW_IP may open the site until: sudo bash bangla-crm.sh finish-setup)
# SETUP_ALLOW_IP=203.0.113.7
